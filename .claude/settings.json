{
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": { "source": "github", "repo": "kepano/obsidian-skills" }
    },
    "anthropic-agent-skills": {
      "source": { "source": "github", "repo": "anthropics/skills" }
    }
  },
  "enabledPlugins": {
    "obsidian@obsidian-skills": true,
    "document-skills@anthropic-agent-skills": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep", "Edit", "Write", "NotebookEdit", "Bash",
      "WebFetch", "WebSearch", "Skill", "Agent", "SendMessage", "ToolSearch",
      "mcp__Context7",
      "mcp__github__get_me", "mcp__github__list_commits", "mcp__github__get_commit",
      "mcp__github__list_branches", "mcp__github__get_file_contents"
    ],
    "deny": [
      "Bash(git push --force*)", "Bash(git push -f*)",
      "Bash(git reset --hard*)", "Bash(rm -rf /*)"
    ]
  }
}